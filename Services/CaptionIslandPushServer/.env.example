# Placeholders only. Never commit real credentials or key material.
APNS_TEAM_ID=YOUR_TEAM_ID
APNS_KEY_ID=YOUR_KEY_ID
APNS_PRIVATE_KEY_PATH=/run/secrets/AuthKey_YOUR_KEY_ID.p8
APNS_ENVIRONMENT=sandbox
APNS_BUNDLE_ID=com.example.youtube.caption
RELAY_ACCESS_TOKEN=CHANGE_ME
PORT=8080

# Strongly recommended in production. Generate with: openssl rand -hex 32
RELAY_STATE_PATH=/var/lib/caption-island/relay.state
RELAY_STATE_KEY=REPLACE_WITH_64_HEX_CHARACTERS
