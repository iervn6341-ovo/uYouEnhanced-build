+    NSString *action = [NSString stringWithFormat:YTABCLocalizedString(bundle, actionKey, actionFallback), topic];
+    NSString *format = includeWarning
+        ? YTABCLocalizedString(bundle, @"FLAG_ANNOTATION_FORMAT", @"Likely purpose: %@. This is a private YouTube flag; its actual behavior may change by app version.")
